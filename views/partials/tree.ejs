<%# Tree of the project. Two levels only, which is all treeSpec produces, so the
    template stays a plain pair of loops: a broken reference is a mark on the
    node, never a save blocker. `full` carries the untruncated mark (the whole
    list of missing servers) and travels in the `title` attribute, so a capped
    label stays readable without hiding anything. %>
<ul class="tree">
  <% for (const node of tree.children) { %>
    <li class="<%= node.stale ? 'stale' : '' %>">
      <a href="<%= '/panel/' + encodeURIComponent(node.key) %>"
         hx-get="/panel/<%= encodeURIComponent(node.key) %>"
         hx-target="#panel"
         hx-swap="innerHTML"
         hx-push-url="true"
         <%- node.full ? `title="${node.full}"` : '' %>
         class="<%= node.key === key ? 'active' : '' %>"><%= node.title %></a>
      <% if (node.children.length > 0) { %>
        <ul>
          <% for (const child of node.children) { %>
            <li class="<%= child.stale ? 'stale' : '' %>">
              <a href="<%= '/panel/' + encodeURIComponent(child.key) %>"
                 hx-get="/panel/<%= encodeURIComponent(child.key) %>"
                 hx-target="#panel"
                 hx-swap="innerHTML"
                 hx-push-url="true"
                 <%- child.full ? `title="${child.full}"` : '' %>
                 class="<%= child.key === key ? 'active' : '' %>"><%= child.title %></a>
            </li>
          <% } %>
        </ul>
      <% } %>
    </li>
  <% } %>
</ul>
