<%# One provider folder: what it holds, and its two editable settings — the
    human-readable name and the «включён» flag. The folder is only read: the tool
    writes nothing into the providers root. A disabled provider shows its content
    but offers no «включить» on its `.conf` rows. %>
<h2><%= panel.title %></h2>

<% if (panel.collisionText) { %>
  <p class="error"><%= panel.collisionText %></p>
<% } %>

<%# Task 20 §2: the diagnosis block. It is on the panel in EVERY state — an empty
    folder, a file that does not read, no access, a chosen kind that finds no file
    — so the kind is always reachable from the interface, never only from
    `webui.json` by hand. The sentence comes from the panel builder, which uses the
    same `describeContent` as the «Найдено» hint. %>
<% if (panel.diagnosis && panel.diagnosis.text) { %>
  <p class="<%= panel.diagnosis.mixed ? 'notice' : panel.diagnosis.state === 'ok' ? 'hint' : 'error' %>">
    <%= panel.diagnosis.text %>
  </p>
  <% if (panel.diagnosis.command) { %>
    <p class="hint">На роутере: <code><%= panel.diagnosis.command %></code></p>
  <% } %>
  <% if (panel.diagnosis.suggest) { %>
    <% if (panel.kindEditable) { %>
      <form class="inline" hx-post="/provider/kind" hx-target="#panel" hx-swap="innerHTML" method="post" action="/provider/kind">
        <input type="hidden" name="id" value="<%= panel.providerId %>">
        <input type="hidden" name="kind" value="<%= panel.diagnosis.suggest.kind %>">
        <input type="hidden" name="from" value="<%= panel.key %>">
        <button type="submit">Сменить вид на «<%= panel.diagnosis.suggest.label %>»</button>
      </form>
    <% } else { %>
      <p class="hint">
        Чтобы сменить вид, снимите галочку «включён» ниже и примените: та же панель
        даёт сменить вид, править файлы руками не нужно.
      </p>
    <% } %>
  <% } %>
<% } %>

<%# §3: the foreign half of a mixed folder is warned about in the generator output;
    the panel says it too, so the interface and the build do not disagree. %>
<% if (panel.provider.warnings && panel.provider.warnings.length > 0) { %>
  <ul class="warnings">
    <% for (const warning of panel.provider.warnings) { %>
      <li><%= warning %></li>
    <% } %>
  </ul>
<% } %>

<form id="panel-form" class="form" hx-post="/provider" hx-target="#panel" hx-swap="innerHTML" method="post" action="/provider">
  <input type="hidden" name="id" value="<%= panel.providerId %>">
  <fieldset>
    <legend>Провайдер</legend>
    <p class="hint">
      Идентификатор — имя папки <code><%= panel.providerId %></code>. Он остаётся в
      <code>tunnels[].provider</code>, ключах панелей и <code>webui.json</code> и не
      меняется;
      <% if (panel.folderKind === 'xray') { %>
        имена серверов — из тегов выходов и адресов (<code><тег> (<хост>)</code>)
        плюс приписка ниже.
      <% } else { %>
        имена серверов берутся из ссылок и приписки ниже.
      <% } %>
      Человекочитаемое имя показывается только в редакторе.
    </p>
    <label for="label">имя</label>
    <%# The file's own profile title is offered as a PLACEHOLDER only: the label is
        the owner's, and pressing «Применить» never writes the title over it (§3.6). %>
    <input type="text" id="label" name="label" value="<%= panel.provider.label ?? '' %>"
           maxlength="64" size="40"
           placeholder="<%= panel.headers && panel.headers.title ? panel.headers.title : panel.providerId %>">
    <% if (panel.headers && panel.headers.title) { %>
      <span class="hint">
        в файле подписки: «<%= panel.headers.title %>» — подставлено подсказкой, подпись не меняется
      </span>
    <% } %>

    <label for="kind">вид</label>
    <% if (panel.kindEditable) { %>
      <select id="kind" name="kind" data-kind-toggle>
        <option value="subscription" <%= panel.folderKind === 'subscription' ? 'selected' : '' %>>Подписка</option>
        <option value="awg" <%= panel.folderKind === 'awg' ? 'selected' : '' %>>Туннели AmneziaWG</option>
        <option value="xray" <%= panel.folderKind === 'xray' ? 'selected' : '' %>>Конфиги Xray</option>
      </select>
    <% } else { %>
      <strong><%= panel.folderKind === 'subscription' ? 'Подписка' : panel.folderKind === 'xray' ? 'Конфиги Xray' : 'Туннели AmneziaWG' %></strong>
      <span class="hint">чтобы сменить вид, выключите провайдера</span>
    <% } %>

    <%# The subscription block (suffix, expiry, тонкие настройки) is rendered for
        every kind but «туннели» and hidden by the script as soon as «Подписка» is
        chosen in the select, so the suffix can be typed in the SAME submit that
        chooses the kind — no reload needed. Without the script the block is simply
        visible; the model ignores it for a tunnel kind (§1а). %>
    <div data-kind-block="subscription" <%= panel.folderKind === 'awg' ? 'hidden' : '' %>>
      <label for="suffix">приписка к именам серверов</label>
      <input type="text" id="suffix" name="suffix" value="<%= panel.suffix %>"
             maxlength="16" size="16" placeholder="(нет)">
      <p class="hint">
        Пусто — имена как <% if (panel.folderKind === 'xray') { %>в конфигах:
        <code><тег> (<хост>)</code><% } else { %>в ссылках<% } %>. Нужна, когда у двух
        включённых провайдеров одинаковые имена серверов (например, vpnd и vpnd-ws).
        Смена приписки переименовывает эти серверы в прокси и маршрутах.
        <% if (panel.firstServerName) { %>
          <br>Пример: <code><%= panel.firstServerName %></code>
        <% } %>
      </p>

      <%# Task 22 §2: the core of a subscription. «Авто» keeps vless/hysteria2 in
          sing-box and sends only XHTTP through Xray; «Xray» sends every server of
          the subscription through it. It changes in any state. %>
      <% if (panel.folderKind === 'subscription' || panel.folderKind === null) { %>
        <label for="engine">ядро</label>
        <select id="engine" name="engine">
          <option value="auto" <%= panel.engine !== 'xray' ? 'selected' : '' %>>авто — Sing-Box, а что он не умеет — Xray</option>
          <option value="xray" <%= panel.engine === 'xray' ? 'selected' : '' %>>Xray — все серверы подписки</option>
        </select>
        <p class="hint">
          «Xray» отдаёт подписку целиком второму ядру. Меняется в любом состоянии;
          применяется «Применить».
        </p>
      <% } %>

      <%# §3.6: the expiry from `#subscription-userinfo`. A passed date warns the
          same way a mark does in the tree; no date means no line at all. %>
      <% if (panel.expiry) { %>
        <p class="<%= panel.expiry.expired ? 'error' : panel.expiry.soon ? 'notice' : 'hint' %>">
          <% if (panel.expiry.expired) { %>
            Подписка истекла <%= panel.expiry.date %>.
          <% } else { %>
            Подписка до <%= panel.expiry.date %><% if (panel.expiry.soon) { %> — осталось <%= panel.expiry.daysLeft %> дн.<% } %>
          <% } %>
        </p>
      <% } %>
    </div>

    <label class="check">
      <input type="checkbox" name="enabled" value="1" <%= panel.enabled ? 'checked' : '' %>>
      включён (серверы попадают в <code>config.json</code>)
    </label>

    <div data-kind-block="subscription" <%= panel.folderKind === 'awg' ? 'hidden' : '' %>>
      <%# The тонкие настройки (flow, fp) are a SUBSCRIPTION concern and do not
          apply to Xray configs, so the block is not rendered for kind «xray»
          (task 19 §6). %>
      <% if (panel.folderKind !== 'xray') { %>
      <details class="overrides" <%= panel.overrides.open ? 'open' : '' %>>
        <summary>Тонкие настройки</summary>
        <p class="hint">
          Авто — как в ссылках. Переопределение действует на все серверы подписки и
          переживает её обновление.
        </p>
        <label for="flow">flow (Vision)</label>
        <select id="flow" name="flow">
          <option value="auto" <%= panel.overrides.flow === 'auto' ? 'selected' : '' %>>Авто</option>
          <option value="vision" <%= panel.overrides.flow === 'vision' ? 'selected' : '' %>>Vision</option>
          <option value="none" <%= panel.overrides.flow === 'none' ? 'selected' : '' %>>без flow</option>
        </select>
        <span class="hint">
          <% if (panel.overrides.nonTcpOnly) { %>
            к этим ссылкам не применяется (<%= panel.overrides.nonTcpSample %>)
          <% } else { %>
            в ссылках: <%= panel.overrides.flowActual %>
          <% } %>
        </span>
        <br>
        <label for="fp">отпечаток (fp)</label>
        <select id="fp" name="fp">
          <option value="auto" <%= panel.overrides.fp === 'auto' ? 'selected' : '' %>>Авто</option>
          <% for (const fingerprint of panel.overrides.fingerprints) { %>
            <option value="<%= fingerprint %>" <%= panel.overrides.fp === fingerprint ? 'selected' : '' %>><%= fingerprint %></option>
          <% } %>
        </select>
        <span class="hint">в ссылках: <%= panel.overrides.fpActual %></span>
      </details>
      <% } %>
    </div>
  </fieldset>
</form>

<p>
  Тип: <strong><%= panel.kindLabel %></strong><br>
  Папка: <code><%= panel.provider.path %></code><br>
  Записей: <%= panel.provider.count %>
  <% if (panel.transports.length > 0) { %>
    <br>Протокол:
    <% for (const item of panel.transports) { %>
      <span class="<%= item.plain ? 'error' : '' %>"><%= item.label %>: <%= item.count %></span>
    <% } %>
    <% if (panel.transports.some((item) => item.plain)) { %>
      <br><span class="error">трафик виден провайдеру связи</span>
    <% } %>
  <% } %>
</p>

<%# For kind «xray» the skipped entries are OUTBOUNDS, not links; they are listed
    inside the server block above, so the generic list is skipped. %>
<% if (panel.skippedCount > 0 && panel.folderKind !== 'xray') { %>
  <h3>Пропущено ссылок: <%= panel.skippedCount %></h3>
  <ul class="warnings">
    <% for (const item of panel.skipped) { %>
      <li><code><%= item.label %></code> — <%= item.reason %></li>
    <% } %>
  </ul>
<% } %>

<%# Kind xray: the copied Xray outbounds, with the protocol, the real address and
    the local port sing-box will use. The generic name list below is skipped for
    this kind, because the table already names every server. %>
<% if (panel.xrayRows) { %>
  <h3>Серверы Xray (<%= panel.xrayRows.length %>)</h3>
  <% if (!panel.xrayInstalled) { %>
    <p class="error">Xray не найден: <code><%= panel.xrayBinary %></code> — включить провайдера нельзя.</p>
  <% } else if (panel.xrayActive === false) { %>
    <p class="notice">Xray остановлен: порты этих серверов не работают, пока он не запущен.</p>
  <% } %>
  <table class="list">
    <thead>
      <tr><th>имя</th><th>протокол</th><th>ядро</th><th>адрес</th><th>порт Xray</th><th>из конфига</th></tr>
    </thead>
    <tbody>
      <% for (const row of panel.xrayRows) { %>
        <tr>
          <td><code><%= row.name %></code></td>
          <td><%= row.protocol %></td>
          <td><%= row.engine %></td>
          <td><%= row.address %><% if (row.remotePort) { %>:<%= row.remotePort %><% } %></td>
          <td><code><%= row.port ?? '—' %></code></td>
          <td><%= row.remark ?? '—' %></td>
        </tr>
      <% } %>
    </tbody>
  </table>
  <% if (panel.xraySkipped.length > 0) { %>
    <h4>Пропущено выходов: <%= panel.xraySkipped.length %></h4>
    <ul class="warnings">
      <% for (const item of panel.xraySkipped) { %>
        <li><code><%= item.label %></code> — <%= item.reason %></li>
      <% } %>
    </ul>
  <% } %>
<% } %>

<%# Names carried by sing-box. A subscription that routes some servers through Xray
    leaves those to the «Серверы Xray» table above, so the two lists never repeat. %>
<% const serverTags = panel.singboxTags ?? panel.provider.tags; %>
<% if (serverTags.length > 0 && panel.folderKind !== 'xray') { %>
  <h3>Серверы (<%= serverTags.length %>)</h3>
  <% if (!panel.enabled) { %>
    <p class="hint">
      Провайдер выключен: в <code>config.json</code> его серверов нет, пока не
      поставите галочку «включён».
    </p>
  <% } %>
  <ul class="tags">
    <% for (const tag of serverTags) { %>
      <li><%= tag %></li>
    <% } %>
  </ul>
<% } %>

<% if (panel.provider.entries.length > 0) { %>
  <h3>Конфиги туннелей (<%= panel.provider.entries.length %>)</h3>
  <% if (!panel.enabled) { %>
    <p class="hint">
      Провайдер выключен: включите его, чтобы отметить конфиги туннелей.
    </p>
  <% } else { %>
    <p class="hint">
      Галочка «включить» нормализует конфиг и кладёт
      <code><имя файла>.conf</code> в каталог туннелей GateHouse; снятие
      галочки останавливает туннель и убирает файл. Имя файла — юнит
      <code>gatehouse-tunnel@<имя файла></code>, поэтому не длиннее 15 символов.
      В <code>config.json</code> конфиги туннелей сами по себе не попадают.
    </p>
    <table class="list">
      <thead>
        <tr><th>файл</th><th>включение и имена</th></tr>
      </thead>
      <tbody>
        <% for (const row of panel.tunnelRows) { %>
          <% const key = `tunnel:${panel.providerId}/${row.file}`; %>
          <tr class="<%= row.marked && !row.applied ? 'stale' : '' %>">
            <td>
              <a href="/panel/<%= encodeURIComponent(key) %>"
                 hx-get="/panel/<%= encodeURIComponent(key) %>"
                 hx-target="#panel"
                 hx-swap="innerHTML"
                 hx-push-url="true"><%= row.file %></a>
            </td>
            <td>
              <form class="inline" hx-post="/tunnels" hx-target="#panel" hx-swap="innerHTML" method="post" action="/tunnels">
                <input type="hidden" name="provider" value="<%= panel.providerId %>">
                <input type="hidden" name="file" value="<%= row.file %>">
                <label class="check">
                  <input type="checkbox" name="needed" value="1" <%= row.marked ? 'checked' : '' %>
                         hx-post="/tunnels" hx-trigger="change"
                         hx-target="#panel" hx-swap="innerHTML" hx-include="closest form">
                  включить
                </label>
                <label>имя туннеля
                  <input type="text" name="name" value="<%= row.name %>" maxlength="255" size="30">
                </label>
                <label>имя файла
                  <input type="text" name="interface" value="<%= row.interface %>" maxlength="15" size="14">
                </label>
                <button type="submit">Применить</button>
                <% if (row.marked) { %>
                  <br><span class="hint"><%= row.applied ? 'файл на месте' : 'файла пока нет' %></span>
                <% } %>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>
<% } %>

<%# A folder WITHOUT a chosen kind still shows what it holds («Записей: 156»):
    repeating the «Найдено» hint is more useful than a claim of emptiness. An empty
    folder and a folder with no access are already explained by the diagnosis block
    above, so they are not called «пуст» here (task 20 §2.3). %>
<% if (panel.folderKind === null && panel.diagnosis.state === 'ok' && panel.provider.hint) { %>
  <p class="hint"><%= panel.provider.hint %></p>
<% } %>

<p>
  <a href="/panel/providers" hx-get="/panel/providers" hx-target="#panel"
     hx-swap="innerHTML" hx-push-url="true">← ко всем провайдерам</a>
</p>
