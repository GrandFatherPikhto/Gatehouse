<%# «Система»: два дочерних узла одной группы. «Sing-Box» — проверка схемы,
    перезапуск демона, откат, журнал и тест серверов; «Amnezia» — жизненный цикл
    туннелей. Дочерний узел выражается КЛЮЧОМ панели (`system:singbox`), и ссылки
    на него рисует ДЕРЕВО: полосы табов внутри панели больше нет, а голый ключ
    `system` приводится к первому ребёнку в `resolvePanel`.
    Формы правки нет ни у одного узла: оба всегда были только для чтения, а форма
    сторожа ушла вместе со сторожем, поэтому `editForm` для этой панели ложно. %>
<h2><%= panel.title %></h2>

<% if (panel.tab === 'amnezia') { %>

  <h3>Туннели</h3>

  <%# §4.1: ONE sudoers block above the table. Missing rules are pasted by the
      owner; the editor never writes the file. The path comes from
      GATEHOUSE_SUDOERS, not from a literal in the template. %>
  <% if (panel.sudoers && !panel.sudoers.readable) { %>
    <p class="error"><%= panel.sudoers.notice %></p>
  <% } else if (panel.sudoers && panel.sudoers.missing.length > 0) { %>
    <% const missingLines = panel.sudoers.missing.flatMap((item) => item.lines); %>
    <div class="sudoers-block notice">
      <p>
        У туннелей <%= panel.sudoers.missing.map((item) => item.label).join(', ') %> нет прав.
        На роутере выполните:
      </p>
      <pre class="output">sudo visudo -f <%= panel.sudoers.path %></pre>
      <p>и допишите в конец:</p>
      <pre class="output" id="sudoers-lines"><%= missingLines.join('\n') %></pre>
      <button type="button" class="secondary" data-copy="#sudoers-lines">Скопировать</button>
      <p class="hint">Потом обновите страницу. Приложение в sudoers не пишет.</p>
    </div>
  <% } %>

  <% if (panel.sudoers && panel.sudoers.extra.length > 0) { %>
    <details class="sudoers-extra">
      <summary>можно удалить из <code><%= panel.sudoers.path %></code>: <%= panel.sudoers.extra.length %></summary>
      <ul class="list-plain">
        <% for (const name of panel.sudoers.extra) { %>
          <li><code>gatehouse-tunnel@<%= name %></code></li>
        <% } %>
      </ul>
    </details>
  <% } %>

  <% if (panel.tunnels.length === 0) { %>
    <p class="hint">
      Ни один туннель не включён. Откройте папку-источник на вкладке «Провайдеры» и
      поставьте галочку «включить» у её <code>.conf</code> — строка появится здесь.
    </p>
  <% } else { %>
    <p class="hint">
      Состояние читается из systemd без привилегий: работает сейчас и поднимается
      при загрузке — две разные оси. Галочка одна и двигает обе
      (<code>enable --now</code> / <code>disable --now</code>); если оси всё же
      разошлись, это написано словами, а не спрятано. Отмеченный «несущий» туннель —
      тот, через который идёт ваш доступ к роутеру: перезапуск или остановка оборвут его.
    </p>
    <% for (const group of panel.tunnels) { %>
      <h4><%= group.provider %></h4>
      <table class="list">
        <thead>
          <tr><th>туннель</th><th>состояние</th><th>поднят</th><th>перезапуск</th><th>прокси</th><th>несущий</th><th>журнал</th></tr>
        </thead>
        <tbody>
          <% for (const tunnel of group.tunnels) { %>
            <tr class="<%= tunnel.applied && (tunnel.active !== tunnel.enabled) ? 'stale' : '' %>">
              <td>
                <% if (tunnel.label) { %><strong><%= tunnel.label %></strong><br><% } %>
                <code><%= tunnel.interface %></code><br><span class="hint"><%= tunnel.unit %></span>
                <% if (tunnel.carrier) { %> <span class="badge">несущий</span><% } %>
              </td>
              <td>
                <% if (!tunnel.applied) { %>
                  конфиг не применён
                <% } else { %>
                  <%= tunnel.active ? 'работает' : 'остановлен' %>,
                  <%= tunnel.enabled ? 'в автозагрузке' : 'не в автозагрузке' %>
                  <% if (tunnel.divergence) { %>
                    <br><span class="error"><%= tunnel.divergence %></span>
                  <% } %>
                <% } %>
              </td>
              <td>
                <% if (!tunnel.applied) { %>
                  —
                <% } else if (tunnel.canToggle) { %>
                  <form class="inline" hx-post="/tunnel/toggle" hx-target="#panel" hx-swap="innerHTML" method="post" action="/tunnel/toggle"<%- tunnel.carrier && tunnel.active && tunnel.enabled ? ' hx-confirm="Через этот туннель идёт ваш доступ к роутеру — вы потеряете связь."' : '' %>>
                    <input type="hidden" name="name" value="<%= tunnel.interface %>">
                    <label class="check">
                      <input type="checkbox" name="up" value="1"
                             hx-post="/tunnel/toggle" hx-trigger="change"
                             hx-target="#panel" hx-swap="innerHTML" hx-include="closest form"
                             <%= tunnel.active && tunnel.enabled ? 'checked' : '' %>>
                      поднят и в автозагрузке
                    </label>
                    <button type="submit"><%= tunnel.active && tunnel.enabled ? 'Опустить' : 'Поднять' %></button>
                  </form>
                <% } else if (!tunnel.sudoersReadable) { %>
                  <p class="error"><%= tunnel.sudoersNotice %></p>
                <% } else { %>
                  <span class="hint">нет права sudoers — добавьте строки:</span>
                  <pre class="output"><%= tunnel.missingLines.join('\n') %></pre>
                <% } %>
              </td>
              <td>
                <% if (tunnel.canRestart) { %>
                  <form class="inline" hx-post="/tunnel/restart" hx-target="#panel" hx-swap="innerHTML" method="post" action="/tunnel/restart">
                    <input type="hidden" name="name" value="<%= tunnel.interface %>">
                    <button type="submit" class="danger"
                            hx-confirm="Перезапустить туннель '<%= tunnel.interface %>'?<%= tunnel.usedBy.length > 0 ? ` Прокси '${tunnel.usedBy.join(', ')}' работают через него и оборвутся.` : '' %><%= tunnel.carrier ? ' Через этот туннель идёт ваш доступ к роутеру — вы потеряете связь.' : '' %>">Перезапустить</button>
                  </form>
                <% } else if (!tunnel.sudoersReadable) { %>
                  <p class="error"><%= tunnel.sudoersNotice %></p>
                <% } else { %>
                  <span class="hint">нет правила sudoers — добавьте строку:</span>
                  <pre class="output"><%= tunnel.missingLines.filter((line) => line.includes('restart')).join('\n') %></pre>
                <% } %>
              </td>
              <td>
                <% if (tunnel.usedBy.length === 0) { %>
                  —
                <% } else { %>
                  <% for (const tag of tunnel.usedBy) { %><code><%= tag %></code> <% } %>
                <% } %>
              </td>
              <td>
                <form class="inline" hx-post="/tunnel/carrier" hx-target="#panel" hx-swap="innerHTML" method="post" action="/tunnel/carrier">
                  <input type="hidden" name="name" value="<%= tunnel.interface %>">
                  <label class="check">
                    <input type="checkbox" name="carrier" value="1"
                           hx-post="/tunnel/carrier" hx-trigger="change"
                           hx-target="#panel" hx-swap="innerHTML" hx-include="closest form"
                           <%= tunnel.carrier ? 'checked' : '' %>>
                    несущий
                  </label>
                </form>
              </td>
              <td><a href="<%= tunnel.journalUrl %>">Журнал</a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    <% } %>
  <% } %>

<% } else { %>

  <h3>Применение</h3>
  <p class="hint">
    Сборка, проверка схемы, установка файла и перезапуск — одна цепочка на полосе
    вверху страницы: <strong>«Применить»</strong>. Шаги: сохранить документ →
    собрать в соседний <code>config.json.new</code> → <code>sing-box check</code>
    временного файла → снимок боевого <code>config.json</code> (последние 10) →
    <code>rename</code> → перезапуск → опрос <code>systemctl is-active</code>. Если
    боевой файл байт в байт совпал со сборкой, перезапуска нет. Если демон не
    поднялся — снимок возвращается и перезапуск повторяется.
  </p>
  <p class="hint">
    <code>sing-box check</code> проверяет <strong>только декодирование</strong>:
    дубль <code>listen_port</code>, ссылку на несуществующий тег и опечатку в
    <code>dns.final</code> он пропускает с <code>exit=0</code>. Поэтому шаг
    называется «проверка схемы», а не «конфиг корректен».
  </p>
  <p class="hint">
    Файл на диске: <code><%= panel.configPath %></code>.
    <% if (!panel.configExists) { %>
      <strong>Файла ещё нет</strong> — нажмите «Применить» на полосе.
    <% } %>
    Юнит: <code><%= panel.unit %></code>; перезапуск идёт через
    <code>sudo -n systemctl restart <%= panel.unit %></code> по единственному
    правилу sudoers, выданному сервису. «Откатить» на полосе возвращает последний
    снимок и перезапускает демон.
  </p>

  <h3>Журнал sing-box</h3>
  <%- include('journal', {panel}) %>

  <h3>Тест серверов</h3>
  <%- include('tests', {panel}) %>

<% } %>
