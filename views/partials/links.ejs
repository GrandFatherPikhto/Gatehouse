<%# Links file: the path (a profile key), how many servers were recognised, and
    the warnings of the parser. A missing file is a normal state of a fresh
    project, so it is reported, not thrown. %>
<h2><%= panel.title %></h2>

<form class="form" hx-post="/links" hx-target="#panel" hx-swap="innerHTML" method="post" action="/links">
  <fieldset>
    <legend>Путь к файлу ссылок</legend>
    <label for="links_file">links_file</label>
    <input type="text" id="links_file" name="links_file" value="<%= panel.info.file %>" size="60">
    <p class="hint">
      Относительный путь считается от каталога webui.json:
      <code><%= panel.info.path %></code>. Файл принадлежит профилю, у разных
      профилей он может быть своим.
    </p>
  </fieldset>
  <button type="submit">Применить</button>
</form>

<h3>Разбор файла</h3>
<% if (panel.info.error) { %>
  <p class="error"><%= panel.info.error %></p>
<% } else { %>
  <p>Распознано серверов: <strong><%= panel.info.tags.length %></strong></p>
  <ul class="tags">
    <% for (const tag of panel.info.tags) { %>
      <li><%= tag %></li>
    <% } %>
  </ul>
<% } %>

<% if (panel.info.warnings.length > 0) { %>
  <h3>Предупреждения</h3>
  <ul class="warnings">
    <% for (const warning of panel.info.warnings) { %>
      <li><%= warning %></li>
    <% } %>
  </ul>
<% } %>
