<%# Снимок журнала: один запрос к `journalctl`, без живого потока и без состояния
    на сервере. Строк не больше `panel.lines`; уровень — минимальный, всё, что
    важнее него, остаётся. Снимок осмысленно звать из места поломки — «покажи
    почему», а не «слежу за строками». %>
<%# The heading is rendered by the «Система» container: this partial is one section
    of a tab. The UNIT and the PANEL KEY come as parameters, so the same partial
    serves the sing-box tab and the Xray tab without hardcoding either. %>
<% const journalUnit = typeof unit === 'string' && unit.length > 0 ? unit : panel.unit; %>
<% const journalKey = typeof key === 'string' && key.length > 0 ? key : 'system:singbox'; %>
<p class="hint">
  Юнит: <code><%= journalUnit %></code>. Читается без привилегий (нужно членство в
  группе <code>adm</code>). Сейчас это снимок: последние
  <strong><%= panel.lines %></strong> строк одним запросом, без живого потока.
</p>

<form method="get" action="/panel/<%= journalKey %>"
      hx-get="/panel/<%= journalKey %>" hx-target="#panel" hx-swap="innerHTML">
  <label for="journal-unit">Юнит</label>
  <input id="journal-unit" name="unit"
         value="<%= panel.snapshot ? panel.snapshot.unit : journalUnit %>">

  <label for="journal-level">Минимальный уровень</label>
  <% const currentLevel = panel.snapshot ? panel.snapshot.level : panel.level; %>
  <select id="journal-level" name="level">
    <% for (const level of panel.levels) { %>
      <option value="<%= level %>" <%= level === currentLevel ? 'selected' : '' %>><%= level %></option>
    <% } %>
  </select>

  <input type="hidden" name="lines" value="<%= panel.lines %>">
  <button type="submit">Обновить</button>
</form>

<% if (panel.snapshot && !panel.snapshot.ok) { %>
  <p class="error">journalctl не удалось прочитать: <%= panel.snapshot.error %></p>
<% } %>

<% const entries = panel.snapshot ? panel.snapshot.entries : []; %>
<% if (entries.length === 0) { %>
  <p class="hint">Строк нет: либо журнал пуст, либо уровень отсекает всё видимое.</p>
<% } else { %>
  <div id="journal-log" class="journal" aria-live="polite">
    <% for (const entry of entries) { %>
      <% const stamp = String(entry.time || '').replace('T', ' ').slice(0, 19); %>
      <div class="journal-line level-<%= entry.level %>">[<%= stamp %>] <%= entry.level %> <%= entry.message %></div>
    <% } %>
  </div>
<% } %>
