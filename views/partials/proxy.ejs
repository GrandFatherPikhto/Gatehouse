<%# One proxy: its own inbound with its own port and its own list of servers.
    Servers that disappeared from the links file stay in the list as checked
    boxes, marked — otherwise the first save would silently drop them. %>
<%# A rejected form must not throw the owner's typing away: when the model rejected
    this edit, `panel.form` holds exactly what the browser sent, and the fields below
    are drawn from it instead of from the stored entry. On success there is no
    `panel.form` and the stored entry is shown, as always. %>
<% const stored = panel.proxy; %>
<% const posted = panel.form && typeof panel.form === 'object' ? panel.form : null; %>
<% const pick = (field, fallback) => (posted && posted[field] !== undefined ? posted[field] : fallback); %>
<% const ticked = (field, fallback) => (posted ? posted[field] === '1' : fallback); %>
<% const proxy = {
     tag: pick('tag', stored.tag),
     type: pick('type', stored.type),
     port: pick('port', stored.port),
     note: pick('note', stored.note ?? ''),
     pinned: ticked('pinned', stored.pinned === true),
     watch: ticked('watch', stored.watch === true),
     watch_url: pick('watch_url', stored.watch_url ?? ''),
   }; %>
<% const current = posted && posted.current !== undefined ? posted.current : stored.tag; %>
<% const servers = posted
     ? (posted.servers === undefined
         ? []
         : (Array.isArray(posted.servers) ? posted.servers : [posted.servers]))
     : (Array.isArray(stored.servers)
         ? stored.servers
         : (stored.servers ? [stored.servers] : [])); %>
<% const known = new Set(panel.tags); %>
<% const excludePrefixes = panel.autoPrefixes ?? []; %>
<h2><%= panel.title %></h2>

<form id="panel-form" class="form" hx-post="/proxy" hx-target="#panel" hx-swap="innerHTML" method="post" action="/proxy">
  <input type="hidden" name="current" value="<%= current %>">

  <fieldset>
    <legend>Инбаунд</legend>
    <label for="tag">tag</label>
    <input type="text" id="tag" name="tag" value="<%= proxy.tag %>" size="40">
    <label for="type">type</label>
    <select id="type" name="type">
      <% for (const type of panel.types) { %>
        <option value="<%= type %>" <%= type === proxy.type ? 'selected' : '' %>><%= type %></option>
      <% } %>
    </select>
    <label for="port">port</label>
    <input type="number" id="port" name="port" value="<%= proxy.port %>" min="1" max="65535">
  </fieldset>

  <fieldset>
    <legend>Выход и сторож</legend>
    <label class="check">
      <input type="checkbox" name="pinned" value="1" <%= proxy.pinned === true ? 'checked' : '' %>>
      выход зафиксирован
    </label>
    <p class="hint">
      Отметка запрещает пул: у закреплённого прокси не может быть двух и более
      серверов. Сохранение с двумя серверами отвергается текстом «у прокси
      зафиксирован выход — снимите отметку, если нужен пул», молча список не
      обрезается. Ядро этот ключ отбрасывает: в <code>config.json</code> он не
      попадает. Рядом поле <code>note</code> — там запишите причину закрепления.
    </p>
    <label class="check">
      <input type="checkbox" name="watch" value="1" <%= proxy.watch === true ? 'checked' : '' %>>
      следить за связью
    </label>
    <p class="hint">
      Сторож проверяет тот же путь, по которому ходит приложение: инбаунд →
      правило маршрута → пул → сервер. Закрытие соединений затрагивает только этот
      прокси; перезапуск демона — все шесть сразу. Сам сторож включается общим
      рубильником в разделе «Сторож».
    </p>
    <label for="watch_url">watch_url</label>
    <input type="text" id="watch_url" name="watch_url" value="<%= proxy.watch_url ?? '' %>" size="60">
    <p class="hint">
      Пусто — нейтральная цель <code><%= panel.defaultWatchUrl %></code>, она
      доказывает живость туннеля и только. Адрес самого сервиса диагностирует
      точнее, но тогда каждые десять минут с выходного IP владельца к сервису
      идёт автоматический запрос: по умолчанию такого не делается.
    </p>
  </fieldset>

  <fieldset>
    <legend>Серверы</legend>
    <p class="hint">
      Ничего не отмечено — прокси идёт в auto-select (все серверы, кроме
      исключённых). Отмеченные серверы образуют пул
      <code>pool-<%= proxy.tag %></code>; снятая галочка убирает сервер из пула.
    </p>
    <% if (panel.linksError) { %>
      <p class="error"><%= panel.linksError %></p>
    <% } %>
    <%# The checked servers come FIRST, in their stored order, and only then the
        rest in links-file order. A browser submits checked boxes in DOCUMENT
        order, so any other layout would silently rewrite the list on the first
        save of a form nobody edited: the stored order of the servers would become
        the order of links.txt, and a server missing from that file would move to
        the end. Keeping document order equal to storage order makes an untouched
        save a no-op, and puts the chosen servers on top, which is also handier. %>
    <% const ordered = [
         ...servers.map((tag) => ({tag, checked: true})),
         ...panel.tags
           .filter((tag) => !servers.includes(tag))
           .map((tag) => ({tag, checked: false})),
       ]; %>
    <div class="servers-picker" data-servers-picker>
      <%# The filter and the clear-all button need the script; without it they stay
          hidden instead of sitting there doing nothing. The checkboxes and the
          submit button work with JavaScript off. %>
      <div class="servers-tools" data-servers-tools hidden>
        <label for="servers-filter">Фильтр</label>
        <input type="search" id="servers-filter" data-servers-filter
               placeholder="страна или город" autocomplete="off">
        <button type="button" class="secondary" data-servers-clear hidden>Снять все</button>
      </div>
      <div class="servers-list" data-servers-list>
        <% for (const {tag, checked} of ordered) { %>
          <% const excluded = excludePrefixes.filter((prefix) => tag.startsWith(prefix)); %>
          <label class="check server" data-server data-tag="<%= tag %>">
            <input type="checkbox" name="servers" value="<%= tag %>"<%= checked ? ' checked' : '' %>>
            <span class="server-tag"><%= tag %></span>
            <% if (!known.has(tag)) { %>
              <span class="badge server-missing">нет в файле ссылок</span>
            <% } %>
            <% if (excluded.length === 0) { %>
              <span class="badge server-auto" title="уходит в auto-select">в auto-select</span>
            <% } else { %>
              <span class="badge server-excluded" title="<%= `исключён по exclude_from_auto: ${excluded.join(', ')}` %>">исключён</span>
            <% } %>
          </label>
        <% } %>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Заметка</legend>
    <label for="note">note</label>
    <input type="text" id="note" name="note" value="<%= proxy.note ?? '' %>" size="60">
  </fieldset>

  <button type="submit">Применить</button>
</form>

<form hx-post="/proxy/remove" hx-target="#panel" hx-swap="innerHTML" method="post" action="/proxy/remove">
  <input type="hidden" name="current" value="<%= current %>">
  <button type="submit" class="danger" hx-confirm="Удалить прокси '<%= current %>'?">Удалить прокси</button>
</form>
