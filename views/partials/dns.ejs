<%# DNS is a JSON text field, and that is a decision, not laziness: sing-box has
    16 kinds of DNS servers, the schema is fresh and still moving, and DNS is
    edited rarely. Only "a valid JSON object" is checked. %>
<h2><%= panel.title %></h2>
<p class="hint">
  Структурных форм здесь нет намеренно: секция dns уезжает в config.json как
  есть. Проверяется только то, что это валидный JSON-объект.
</p>

<form id="panel-form" class="form" hx-post="/dns" hx-target="#panel" hx-swap="innerHTML" method="post" action="/dns">
  <textarea name="dns" rows="20" cols="80" spellcheck="false"><%= panel.json %></textarea>
  <button type="submit">Применить DNS</button>
</form>
