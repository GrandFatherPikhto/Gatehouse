<%# The permanent apply bar over the tree and the panel, on every page.
    It answers one question with four states (by priority): unsaved edits, a failed
    apply, saved-but-not-applied, applied. The comparison behind "not applied" is
    built in `src/web/apply-bar.mjs` and never writes a file.
    «Сохранить» keeps the old behaviour that a field not sent through «Применить»
    is not thrown away: htmx pulls the open form in with hx-include, and the
    `form="panel-form"` attribute does the same with JavaScript off. A panel with
    no edit form (`proxies`, `routes`, `system`, `journal`, `tests`) keeps the
    standalone save; a broken `form=""` reference would stop that button from
    submitting at all. «Перечитать с диска» is deliberately NOT bound: reloading is
    supposed to discard. %>
<div class="status-line">
  <strong><%= status.name %></strong>
  <% if (status.path) { %>
    <span class="muted"><%= status.path %></span>
    <% if (!status.exists) { %><span class="badge">файл ещё не создан</span><% } %>
  <% } else { %>
    <span class="muted">файл ещё не создан</span>
  <% } %>
</div>
<div class="apply-bar apply-<%= apply.state %>" role="status">
  <span class="apply-dot" aria-hidden="true"></span>
  <span class="apply-text"><%= apply.message %></span>
  <% if (apply.detail) { %>
    <span class="apply-detail"><%= apply.detail %></span>
  <% } %>
  <% if (apply.lastAppliedAt) { %>
    <span class="muted apply-when">применено <%= apply.lastAppliedAt %></span>
  <% } %>
</div>
<div class="status-actions">
  <% if (editForm) { %>
    <% const saveUrl = `/save?panel=${encodeURIComponent(key)}`; %>
    <form method="post" action="<%= saveUrl %>">
      <button type="submit" class="<%= apply.state === 'dirty' ? 'primary' : '' %>"
              hx-post="<%= saveUrl %>" hx-target="#panel" hx-swap="innerHTML"
              hx-include="#panel-form"
              form="panel-form" formaction="<%= saveUrl %>" formmethod="post">Сохранить</button>
    </form>
  <% } else { %>
    <form hx-post="/save" hx-target="#panel" hx-swap="innerHTML" method="post" action="/save">
      <input type="hidden" name="panel" value="<%= key %>">
      <button type="submit" class="<%= apply.state === 'dirty' ? 'primary' : '' %>">Сохранить</button>
    </form>
  <% } %>
  <%# «Применить» takes the open edit form exactly like «Сохранить»: htmx pulls the
      fields in with hx-include, and the form="" attribute does the same with
      JavaScript off. A panel with no form keeps the standalone post.
      «Откатить» and «Перечитать с диска» deliberately do NOT take the form — they
      discard edits by design — but warn when the open form has unsaved changes
      (the script, `data-form-guard`). %>
  <% if (editForm) { %>
    <% const applyUrl = `/apply?panel=${encodeURIComponent(key)}`; %>
    <form method="post" action="<%= applyUrl %>">
      <button type="submit" class="<%= apply.state === 'pending' ? 'primary' : '' %>"
              <%= apply.applyButton === false ? 'disabled' : '' %>
              hx-post="<%= applyUrl %>" hx-target="#panel" hx-swap="innerHTML"
              hx-include="#panel-form"
              form="panel-form" formaction="<%= applyUrl %>" formmethod="post"
              hx-confirm="Перезапуск sing-box оборвёт текущие соединения через все прокси. Применить?">Применить</button>
    </form>
  <% } else { %>
    <form hx-post="/apply" hx-target="#panel" hx-swap="innerHTML" method="post" action="/apply">
      <input type="hidden" name="panel" value="<%= key %>">
      <button type="submit" class="<%= apply.state === 'pending' ? 'primary' : '' %>"
              <%= apply.applyButton === false ? 'disabled' : '' %>
              hx-confirm="Перезапуск sing-box оборвёт текущие соединения через все прокси. Применить?">Применить</button>
    </form>
  <% } %>
  <form hx-post="/rollback?panel=<%= encodeURIComponent(key) %>" hx-target="#panel" hx-swap="innerHTML" method="post" action="/rollback?panel=<%= encodeURIComponent(key) %>">
    <button type="submit" class="secondary" <%= apply.canRollback ? '' : 'disabled' %>
            data-form-guard="#panel-form"
            data-base-confirm="Вернуть предыдущий config.json и перезапустить sing-box? Текущие соединения оборвутся."
            hx-confirm="Вернуть предыдущий config.json и перезапустить sing-box? Текущие соединения оборвутся.">Откатить</button>
  </form>
  <form hx-post="/reload" hx-target="#panel" hx-swap="innerHTML" method="post" action="/reload">
    <input type="hidden" name="panel" value="<%= key %>">
    <button type="submit" class="secondary" data-form-guard="#panel-form">Перечитать с диска</button>
  </form>
</div>
<%# Build warnings of §1 — one line per proxy or route. `apply.warnings` is already
    capped by the bar; `warningsMore` is the rest. %>
<% if (apply.warnings && apply.warnings.length > 0) { %>
  <ul class="warnings">
    <% for (const warning of apply.warnings) { %>
      <li><%= warning %></li>
    <% } %>
    <% if (apply.warningsMore > 0) { %>
      <li>ещё <%= apply.warningsMore %></li>
    <% } %>
  </ul>
<% } %>
<%# A step is ✅ ok, ⚠️ a warning that did not stop the chain (a service that would
    not stop, task 19 §4), or ❌ a failure. `step.detail` carries the full command
    output, shown on demand so the bar line stays short (task 19 §2). %>
<% if (apply.steps && apply.steps.length > 0) { %>
  <ol class="apply-steps">
    <% for (const step of apply.steps) { %>
      <li class="<%= step.warn ? 'warn' : step.ok ? 'ok' : 'bad' %>">
        <span class="mark"><%= step.warn ? '⚠️' : step.ok ? '✅' : '❌' %></span>
        <strong><%= step.step %></strong> — <%= step.message %>
        <% if (step.detail) { %>
          <details><summary>подробно</summary><pre class="output"><%= step.detail %></pre></details>
        <% } %>
      </li>
    <% } %>
  </ol>
<% } %>
