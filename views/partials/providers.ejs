<%# Providers: the folders under the sources root. The folder name IS the provider
    name; a folder may hold links.txt (turned into outbounds), tunnel configs
    (*.conf, listed but NEVER turned into outbounds), or both.
    The list is edited as a LIST — a folder is added from the ones that exist, or
    removed by the button on its row; the folder on disk is never touched.
    One provider is exactly one row. %>
<h2><%= panel.title %></h2>

<p class="hint">
  Корень источников: <code><%= panel.info.root %></code>
  (переопределяется переменной <code>GATEHOUSE_SOURCES</code>).
  Новую папку создают на диске; список и содержимое папок перечитываются при
  каждом открытии вкладки.
</p>

<h3>Подключённые источники</h3>
<% if (panel.info.providers.length === 0) { %>
  <p class="hint">Источники не заданы: добавьте папку ниже.</p>
<% } else { %>
  <table class="list">
    <thead>
      <tr>
        <th>провайдер</th><th>содержимое</th><th>записей</th><th>изменён</th>
        <th>туннели (в конфиг не попадают)</th><th>состояние</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% for (const provider of panel.info.providers) { %>
        <tr class="<%= provider.error ? 'stale' : '' %>">
          <td>
            <% const key = `provider:${provider.name}`; %>
            <a href="/panel/<%= encodeURIComponent(key) %>"
               hx-get="/panel/<%= encodeURIComponent(key) %>"
               hx-target="#panel"
               hx-swap="innerHTML"
               hx-push-url="true"><code><%= provider.name %></code></a>
          </td>
          <td><%= provider.kind %></td>
          <td><%= provider.count %></td>
          <td><%= provider.mtime ?? '—' %></td>
          <td>
            <% if (provider.entries.length === 0) { %>
              —
            <% } else { %>
              <% for (const entry of provider.entries) { %>
                <% const key = `tunnel:${provider.name}/${entry}`; %>
                <a href="/panel/<%= encodeURIComponent(key) %>"
                   hx-get="/panel/<%= encodeURIComponent(key) %>"
                   hx-target="#panel"
                   hx-swap="innerHTML"
                   hx-push-url="true"><%= entry %></a><% if (entry !== provider.entries[provider.entries.length - 1]) { %>, <% } %>
              <% } %>
            <% } %>
          </td>
          <td>
            <% if (provider.error) { %>
              <span class="error"><%= provider.error %></span>
            <% } else { %>
              ок
            <% } %>
          </td>
          <td>
            <form hx-post="/providers" hx-target="#panel" hx-swap="innerHTML" method="post" action="/providers" class="inline">
              <input type="hidden" name="action" value="remove">
              <input type="hidden" name="name" value="<%= provider.name %>">
              <button type="submit" class="secondary">Убрать</button>
            </form>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<h3>Добавить источник</h3>
<% if (panel.available.length === 0) { %>
  <p class="hint">
    Под корнем нет папок, которых ещё нет в списке. Создайте папку на диске и
    нажмите «Перечитать».
  </p>
<% } else { %>
  <form hx-post="/providers" hx-target="#panel" hx-swap="innerHTML" method="post" action="/providers" class="inline">
    <input type="hidden" name="action" value="add">
    <label for="source-name">папка</label>
    <select id="source-name" name="name">
      <% for (const name of panel.available) { %>
        <option value="<%= name %>"><%= name %></option>
      <% } %>
    </select>
    <button type="submit">Добавить</button>
  </form>
<% } %>
<%# The merged outbound list is deliberately NOT shown here: it belongs to the
    folder that produced it. Open a provider to see the servers that one hands out. %>

<% if (panel.info.warnings.length > 0) { %>
  <h3>Предупреждения</h3>
  <ul class="warnings">
    <% for (const warning of panel.info.warnings) { %>
      <li><%= warning %></li>
    <% } %>
  </ul>
<% } %>
