<%# Providers are DISCOVERED under GATEHOUSE_PROVIDERS: every sub-folder is a
    provider and its name is the identifier. This panel lists what was found,
    lets the owner tick «включён», and shows what could not be read with the
    reason. There is NO path field anywhere: the browser never names a path. %>
<h2><%= panel.title %></h2>

<p class="hint">
  Провайдеры читаются из каталога <code><%= panel.info.root %></code>
  (<%= panel.info.rootSource %>). Каждая подпапка — провайдер: <code>links.txt</code>
  даёт серверы Sing-Box, <code>*.conf</code> — конфиги туннелей Amnezia. Имя папки —
  это идентификатор (он идёт в теги серверов и в <code>config.json</code>),
  человекочитаемое имя правится на панели провайдера. Провайдер без галочки найден,
  но выключен: его серверов в <code>config.json</code> нет.
</p>

<% if (panel.info.rootState.message) { %>
  <p class="error"><%= panel.info.rootState.message %></p>
<% } %>

<h3>Найденные провайдеры</h3>
<% if (panel.info.providers.length === 0) { %>
  <p class="hint">
    Провайдеры не найдены: положите папку с <code>links.txt</code> или
    <code>*.conf</code> в <code><%= panel.info.root %></code>.
  </p>
<% } else { %>
  <table class="list">
    <thead>
      <tr><th>провайдер</th><th>имя папки</th><th>тип</th><th>записей</th><th>включён</th></tr>
    </thead>
    <tbody>
      <% for (const provider of panel.info.providers) { %>
        <% const key = `provider:${provider.id}`; %>
        <tr>
          <td>
            <a href="/panel/<%= encodeURIComponent(key) %>"
               hx-get="/panel/<%= encodeURIComponent(key) %>"
               hx-target="#panel"
               hx-swap="innerHTML"
               hx-push-url="true"><%= provider.displayName %></a>
          </td>
          <td><code><%= provider.id %></code></td>
          <td><%= provider.kindLabel %></td>
          <td><%= provider.count %></td>
          <td>
            <form class="inline" hx-post="/provider/enabled" hx-target="#panel" hx-swap="innerHTML" method="post" action="/provider/enabled">
              <input type="hidden" name="id" value="<%= provider.id %>">
              <label class="check">
                <input type="checkbox" name="enabled" value="1" <%= provider.enabled ? 'checked' : '' %>
                       hx-post="/provider/enabled" hx-trigger="change"
                       hx-target="#panel" hx-swap="innerHTML" hx-include="closest form">
                включён
              </label>
            </form>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<h3>Не прочиталось</h3>
<% if (panel.info.unread.length === 0) { %>
  <p class="hint">Всё, что лежит в каталоге, прочитано.</p>
<% } else { %>
  <table class="list">
    <thead>
      <tr><th>запись</th><th>состояние</th><th>причина</th><th></th></tr>
    </thead>
    <tbody>
      <% for (const entry of panel.info.unread) { %>
        <tr class="stale">
          <td><code><%= entry.displayName %></code></td>
          <td><%= entry.stateLabel %></td>
          <td><span class="error"><%= entry.error %></span></td>
          <td>
            <% if (entry.forget) { %>
              <form class="inline" hx-post="/provider/forget" hx-target="#panel" hx-swap="innerHTML" method="post" action="/provider/forget">
                <input type="hidden" name="id" value="<%= entry.id %>">
                <button type="submit" class="secondary">Забыть</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<% if (panel.info.warnings.length > 0) { %>
  <h3>Предупреждения</h3>
  <ul class="warnings">
    <% for (const warning of panel.info.warnings) { %>
      <li><%= warning %></li>
    <% } %>
  </ul>
<% } %>
