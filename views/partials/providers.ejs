<%# Providers: the origins the config is built from. A source is ONE explicit
    origin, chosen by the owner:
      * «Ссылки Sing-Box» — a single file of VLESS links turned into outbounds;
      * «Туннели Amnezia» — a directory of `*.conf` listed but NEVER turned into
        outbounds.
    The path is stored as typed; a relative one resolves against the settings
    directory. The tool reads the origin and never writes to it: removing an
    entry means "do not read it", not "delete the owner's files". %>
<h2><%= panel.title %></h2>

<p class="hint">
  Источник — это либо <strong>один файл со ссылками</strong> (аутбаунды
  Sing-Box), либо <strong>каталог конфигов туннелей</strong> Amnezia
  (<code>*.conf</code>). Путь можно указать абсолютным или относительным — он
  разрешается от каталога настроек <code><%= panel.baseDir %></code>.
  Инструмент читает источник и никогда в него не пишет.
</p>

<h3>Подключённые источники</h3>
<% if (panel.info.providers.length === 0) { %>
  <p class="hint">Источники не заданы: добавьте файл ссылок или каталог туннелей ниже.</p>
<% } else { %>
  <table class="list">
    <thead>
      <tr>
        <th>провайдер</th><th>тип</th><th>путь</th><th>записей</th><th>изменён</th>
        <th>туннели (в конфиг не попадают)</th><th>состояние</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% for (const provider of panel.info.providers) { %>
        <tr class="<%= provider.error ? 'stale' : '' %>">
          <td>
            <% const key = `provider:${provider.name}`; %>
            <a href="/panel/<%= encodeURIComponent(key) %>"
               hx-get="/panel/<%= encodeURIComponent(key) %>"
               hx-target="#panel"
               hx-swap="innerHTML"
               hx-push-url="true"><code><%= provider.name %></code></a>
          </td>
          <td><%= provider.kindLabel %></td>
          <td><code><%= provider.path %></code></td>
          <td><%= provider.count %></td>
          <td><%= provider.mtime ?? '—' %></td>
          <td>
            <% if (provider.entries.length === 0) { %>
              —
            <% } else { %>
              <% for (const entry of provider.entries) { %>
                <% const entryKey = `tunnel:${provider.name}/${entry}`; %>
                <a href="/panel/<%= encodeURIComponent(entryKey) %>"
                   hx-get="/panel/<%= encodeURIComponent(entryKey) %>"
                   hx-target="#panel"
                   hx-swap="innerHTML"
                   hx-push-url="true"><%= entry %></a><% if (entry !== provider.entries[provider.entries.length - 1]) { %>, <% } %>
              <% } %>
            <% } %>
          </td>
          <td>
            <% if (provider.error) { %>
              <span class="error"><%= provider.error %></span>
            <% } else { %>
              ✔ ок
            <% } %>
          </td>
          <td>
            <form hx-post="/providers" hx-target="#panel" hx-swap="innerHTML" method="post" action="/providers" class="inline">
              <input type="hidden" name="action" value="remove">
              <input type="hidden" name="name" value="<%= provider.name %>">
              <button type="submit" class="secondary">Убрать</button>
            </form>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<h3>Добавить источник</h3>
<p class="hint">
  Выберите тип источника и укажите путь. Файл ссылок, который прочитался,
  отмечается галочкой; если файла нет или он не читается — под формой будет
  ошибка, и в список ничего не попадёт. Для каталога Amnezia читается список
  <code>*.conf</code> и создаётся панель провайдера.
</p>
<form hx-post="/providers" hx-target="#panel" hx-swap="innerHTML" method="post" action="/providers">
  <input type="hidden" name="action" value="add">
  <fieldset>
    <legend>тип источника</legend>
    <label class="check">
      <input type="radio" name="kind" value="links" checked>
      ссылки Sing-Box (файл)
    </label>
    <label class="check">
      <input type="radio" name="kind" value="tunnels">
      туннели Amnezia (каталог)
    </label>
  </fieldset>
  <label>имя провайдера
    <input type="text" name="name" maxlength="255" size="30" placeholder="vpnd">
  </label>
  <label>путь к файлу или каталогу
    <input type="text" name="path" maxlength="1024" size="60"
           placeholder="sources/vpnd/links.txt">
  </label>
  <button type="submit">Добавить</button>
</form>
<%# The merged outbound list is deliberately NOT shown here: it belongs to the
    provider that produced it. Open a provider to see the servers it hands out. %>

<% if (panel.info.warnings.length > 0) { %>
  <h3>Предупреждения</h3>
  <ul class="warnings">
    <% for (const warning of panel.info.warnings) { %>
      <li><%= warning %></li>
    <% } %>
  </ul>
<% } %>
