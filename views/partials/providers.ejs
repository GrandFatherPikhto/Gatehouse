<%# Providers are DISCOVERED under GATEHOUSE_PROVIDERS: every sub-folder is a
    provider and its name is the identifier. This panel lists what was found,
    lets the owner tick «включён», and shows what could not be read with the
    reason. There is NO path field anywhere: the browser never names a path. %>
<h2><%= panel.title %></h2>

<p class="hint">
  Провайдеры читаются из каталога <code><%= panel.info.root %></code>
  (<%= panel.info.rootSource %>). Каждая подпапка — провайдер, а вид папки задаёт
  владелец: «подписка» читает только <code>links.txt</code>, «туннели» — только
  <code>*.conf</code>, «конфиги Xray» — только <code>xray-configs.json</code>.
  Папка без вида попадает в «Найдено, не подключено» и в сборке не участвует.
  Имя папки — идентификатор (он остаётся в <code>tunnels[].provider</code> и
  <code>webui.json</code>).
</p>

<% if (panel.info.rootState.message) { %>
  <p class="error"><%= panel.info.rootState.message %></p>
<% } %>

<% if (panel.collisionText) { %>
  <p class="error"><%= panel.collisionText %></p>
<% } %>

<h3>Выходы</h3>
<ul class="list">
  <% for (const [key, label, list] of [
       ['outputs:subscriptions', 'Подписки', panel.info.subscriptions],
       ['outputs:tunnels', 'Туннели AmneziaWG', panel.info.awg],
       ['outputs:found', 'Найдено, не подключено', panel.info.found],
     ]) { %>
    <li>
      <a href="/panel/<%= encodeURIComponent(key) %>"
         hx-get="/panel/<%= encodeURIComponent(key) %>"
         hx-target="#panel"
         hx-swap="innerHTML"
         hx-push-url="true"><%= label %>: <%= list.length %><% if (list.some((p) => p.enabled)) { %>
         (включено <%= list.filter((p) => p.enabled).length %>)<% } %></a>
    </li>
  <% } %>
</ul>

<h3>Не прочиталось</h3>
<% if (panel.info.unread.length === 0) { %>
  <p class="hint">Всё, что лежит в каталоге, прочитано.</p>
<% } else { %>
  <table class="list">
    <thead>
      <tr><th>запись</th><th>состояние</th><th>причина</th><th></th></tr>
    </thead>
    <tbody>
      <% for (const entry of panel.info.unread) { %>
        <tr class="stale">
          <td><code><%= entry.displayName %></code></td>
          <td><%= entry.stateLabel %></td>
          <td><span class="error"><%= entry.error %></span></td>
          <td>
            <% if (entry.forget) { %>
              <form class="inline" hx-post="/provider/forget" hx-target="#panel" hx-swap="innerHTML" method="post" action="/provider/forget">
                <input type="hidden" name="id" value="<%= entry.id %>">
                <button type="submit" class="secondary">Забыть</button>
              </form>
            <% } %>
            <%# §4: a record whose folder is gone and a new folder of the same
                content are usually one rename. Nothing is guessed by NAME: the
                candidates are found folders with no record and fitting content. %>
            <% if (entry.relocation && entry.relocation.length > 0) { %>
              <div class="hint">
                папки нет; возможно, переименована в:
                <% if (entry.relocation.length === 1) { %>
                  <% const candidate = entry.relocation[0]; %>
                  «<%= candidate.id %>»
                  <form class="inline" hx-post="/provider/move" hx-target="#panel" hx-swap="innerHTML" method="post" action="/provider/move">
                    <input type="hidden" name="from" value="<%= entry.id %>">
                    <input type="hidden" name="to" value="<%= candidate.id %>">
                    <button type="submit" class="secondary">Перенести настройки в <%= candidate.id %></button>
                  </form>
                <% } else { %>
                  <form class="inline" hx-post="/provider/move" hx-target="#panel" hx-swap="innerHTML" method="post" action="/provider/move">
                    <input type="hidden" name="from" value="<%= entry.id %>">
                    <select name="to">
                      <% for (const candidate of entry.relocation) { %>
                        <option value="<%= candidate.id %>"><%= candidate.id %></option>
                      <% } %>
                    </select>
                    <button type="submit" class="secondary">Перенести настройки</button>
                  </form>
                <% } %>
              </div>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>

<% if (panel.info.warnings.length > 0) { %>
  <h3>Предупреждения</h3>
  <ul class="warnings">
    <% for (const warning of panel.info.warnings) { %>
      <li><%= warning %></li>
    <% } %>
  </ul>
<% } %>
