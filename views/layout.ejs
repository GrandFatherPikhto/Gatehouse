<%# Full page. The same fragments are rendered by partials/response.ejs for htmx. %>
<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>webui.json — <%= status.name %></title>
    <%# The icon lives under /static like the rest of the assets, and the same
        bytes answer /favicon.ico, which a browser requests without being asked. %>
    <link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
    <link rel="icon" href="/static/favicon.ico" sizes="any">
    <link rel="stylesheet" href="/static/app.css">
    <%# htmx is served from our own public/vendor: the editor has to work on a
        router with no internet access. %>
    <script src="/static/vendor/htmx.min.js" defer></script>
    <%# Filter of the proxy servers picker. A module, so the test suite can import
        the filter and assert that it hides rows instead of removing them. %>
    <script src="/static/app.js" type="module"></script>
  </head>
  <body>
    <%# The marker is derived from the paths, not from a flag: in the sandbox
        `systemctl` does nothing, so the difference has to be impossible to miss. %>
    <% if (sandbox) { %>
      <p class="notice sandbox-note" role="status">
        <strong>Песочница:</strong> пути ведут в <code>dev/</code>, а
        <code>systemctl</code> и <code>sudo</code> — заглушки. Боевые службы и
        роутер не затрагиваются.
      </p>
    <% } %>
    <header id="status"><%- include('partials/status', {status, key, editForm: panel.editForm}) %></header>
    <main>
      <nav id="tree"><%- include('partials/tree', {tree, key}) %></nav>
      <section id="panel">
        <%- include('partials/notices', {error: extra.error ?? null, notice: extra.notice ?? null}) %>
        <%- include('partials/panel', {panel}) %>
      </section>
    </main>
    <footer>
      Редактор <code>webui.json</code> и генерация <code>config.json</code>.
      В дереве «Система» — две дочерние ноды: «Sing-Box» (проверка конфига,
      перезапуск демона и откат вместе с журналом и тестом серверов) и «Amnezia»
      (туннели). Так же, как у группы «Настройки».
      <span class="muted">Через открытый HTTP токен идёт без шифрования —
        надёжнее <code>127.0.0.1</code> плюс ssh-туннель.</span>
    </footer>
  </body>
</html>
