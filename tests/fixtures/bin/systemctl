#!/usr/bin/env node
// Fake `systemctl`, doubling as the `sudo` stand-in of the tests.
//
// `restartSingBox` runs `sudo -n <systemctl> restart sing-box`. Pointing both
// `GATEHOUSE_SUDO` and `GATEHOUSE_SYSTEMCTL` at this file makes the argv
// observable without touching the real systemd, and keeps the test suite free of
// `sudo` and of root.
//
// It also answers the read-only verbs the tunnel panel and the apply chain need,
// from the environment, so the systemd axes can be reproduced:
//   * `FAKE_SYSTEMCTL_ACTIVE`   — comma-separated list of active units;
//   * `FAKE_SYSTEMCTL_ENABLED`  — comma-separated list of enabled units;
//   * `FAKE_SYSTEMCTL_INACTIVE` — units forced to answer "inactive"/"disabled".
// An empty or absent list means "nothing is active/enabled".
//
// The sing-box unit (`GATEHOUSE_UNIT`) answers "active"/"enabled" by DEFAULT:
// the apply chain polls `systemctl is-active` after a restart, and a fake that
// answered "inactive" would make every restart look failed and roll the config
// back. A test that needs a daemon that did not come up lists the unit in
// `FAKE_SYSTEMCTL_INACTIVE`. Tunnel units keep the plain list-driven behaviour.
//
// `FAKE_SYSTEMCTL_FAIL` makes any other verb exit non-zero, for the "restart
// failed" path.

import fs from 'node:fs';
import process from 'node:process';

const argv = process.argv.slice(2);

if (process.env.FAKE_SYSTEMCTL_ARGV_LOG) {
  fs.appendFileSync(process.env.FAKE_SYSTEMCTL_ARGV_LOG, `${JSON.stringify(argv)}\n`);
}

const list = (value) => String(value ?? '').split(',').map((item) => item.trim()).filter(Boolean);

const gateUnit = process.env.GATEHOUSE_UNIT || 'sing-box';
const forcedInactive = list(process.env.FAKE_SYSTEMCTL_INACTIVE);

if (argv[0] === 'is-active') {
  const unit = argv[1];
  let active = list(process.env.FAKE_SYSTEMCTL_ACTIVE).includes(unit);
  if (unit === gateUnit && !forcedInactive.includes(unit)) active = true;
  process.stdout.write(`${active ? 'active' : 'inactive'}\n`);
  process.exit(0);
}

if (argv[0] === 'is-enabled') {
  const unit = argv[1];
  let enabled = list(process.env.FAKE_SYSTEMCTL_ENABLED).includes(unit);
  if (unit === gateUnit && !forcedInactive.includes(unit)) enabled = true;
  process.stdout.write(`${enabled ? 'enabled' : 'disabled'}\n`);
  process.exit(0);
}

process.stdout.write(`fake systemctl: ${argv.join(' ')}\n`);

if (process.env.FAKE_SYSTEMCTL_FAIL) {
  process.stderr.write('fake systemctl: unit sing-box.service not found\n');
  process.exit(1);
}

process.exit(0);
