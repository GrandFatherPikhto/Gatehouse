#!/usr/bin/env node
// Fake `curl` for the watchdog tests.
//
// It repeats the exit codes and the shapes the real `curl` gives when it is asked
// to probe an inbound with `-x <proxy> -s -S -o /dev/null -w %{http_code}`:
//   * success          — prints `204` and exits 0;
//   * failure          — prints a connection error on stderr and exits 7;
//   * timeout          — prints the exit-28 wording of `--max-time` and exits 28.
//
// The outcome is chosen by `FAKE_CURL_MODE` (ok|fail|timeout) or, when that is not
// set, by the first line of `FAKE_CURL_MODE_FILE`. The file variant is what lets a
// test change the answer between two checks; no global juggling and no randomness.
//
// `FAKE_CURL_ARGV_LOG` appends the received argv as JSON, one array per line — this
// is how the test proves the check really goes through the inbound (`-x …`) and not
// through `sing-box tools fetch`.

import fs from 'node:fs';
import process from 'node:process';

const argv = process.argv.slice(2);

if (process.env.FAKE_CURL_ARGV_LOG) {
  fs.appendFileSync(process.env.FAKE_CURL_ARGV_LOG, `${JSON.stringify(argv)}\n`);
}

let mode = process.env.FAKE_CURL_MODE ?? 'ok';
if (!process.env.FAKE_CURL_MODE && process.env.FAKE_CURL_MODE_FILE) {
  try {
    mode = fs.readFileSync(process.env.FAKE_CURL_MODE_FILE, 'utf8').trim().split('\n')[0] || 'ok';
  } catch {
    mode = 'ok';
  }
}

if (mode === 'timeout') {
  process.stderr.write('curl: (28) Operation timed out after 8000 milliseconds\n');
  process.exit(28);
}

if (mode === 'fail') {
  process.stderr.write('curl: (7) Failed to connect to 127.0.0.1 port 54321: Connection refused\n');
  process.exit(7);
}

process.stdout.write('204');
process.exit(0);
