{
  "version": 2,
  "listen_ip": "127.0.0.1",
  "providers": {
    "vpnd": {
      "enabled": true
    }
  },
  "output_file": "config.json",
  "exclude_from_auto": [
    "🇷🇺"
  ],
  "urltest": {
    "url": "https://gstatic.com",
    "interval": "3m",
    "tolerance": 50
  },
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local"
      }
    ],
    "final": "dns-local"
  },
  "proxies": [
    {
      "tag": "main-socks",
      "type": "socks",
      "port": 54321
    },
    {
      "tag": "apps-http",
      "type": "http",
      "port": 54323,
      "servers": [
        "🇫🇮 Finland - Helsinki 1",
        "🇳🇱 Netherlands - Amsterdam"
      ]
    }
  ],
  "routes": {
    "telegram": {
      "outbound": "auto-select",
      "domains": [
        "t.me",
        "telegram.org"
      ]
    }
  }
}
