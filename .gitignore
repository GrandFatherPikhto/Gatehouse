# --- Dependencies ----------------------------------------------------------
node_modules/

# --- Generated output ------------------------------------------------------
# config.json is produced by the generator from webui.json + a links file.
config.json
webui.json
*.json.bak

# --- Local data ------------------------------------------------------------
# Subscription dumps and personal server lists never go to the repository.
*.txt
# ...except the synthetic test fixture: without it the suite cannot run
# from a clean clone (this exact problem already bit the Python project).
!tests/fixtures/links.txt

# Runtime state of the web editor: snapshots of webui.json taken before every
# save. The location is configurable (SINGBOX_WEBUI_STATE_DIR); this is the
# default one, and it belongs to the machine, not to the repository.
.state/

