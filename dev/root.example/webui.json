{
  "version": 2,
  "note": "Anonymised sample of the dev sandbox model.",
  "listen_ip": "127.0.0.1",
  "sources": [
    "vpnd"
  ],
  "output_file": "etc/sing-box/config.json",
  "exclude_from_auto": [
    "🇷🇺"
  ],
  "urltest": {
    "url": "https://gstatic.com",
    "interval": "3m",
    "tolerance": 50
  },
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local"
      }
    ],
    "final": "dns-local"
  },
  "proxies": [
    {
      "tag": "main",
      "type": "mixed",
      "port": 54321,
      "servers": [
        "🇫🇮 Finland - Helsinki 1"
      ]
    }
  ],
  "routes": {
    "telegram": {
      "outbound": "auto-select",
      "domains": [
        "t.me",
        "telegram.org"
      ]
    }
  }
}
