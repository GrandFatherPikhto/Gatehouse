# Секреты GateHouse. Скопируйте в /etc/gatehouse/env, впишите токен и
# выставьте права 0640 с владельцем root:denis:
#
#   sudo install -d -m 0750 -o denis -g denis /etc/gatehouse
#   sudo cp deploy/gatehouse.env.example /etc/gatehouse/env
#   sudo chown root:denis /etc/gatehouse/env
#   sudo chmod 0640 /etc/gatehouse/env
#
# ПОЧЕМУ ОТДЕЛЬНЫЙ ФАЙЛ, А НЕ Environment= В ЮНИТЕ: `systemctl cat` показывает
# содержимое юнита любому пользователю системы, а этот файл читает только root и
# группа denis.
#
# Токен обязателен, если GATEHOUSE_HOST не адрес обратной петли: без него
# сервер откажется стартовать. Сгенерировать:
#
#   openssl rand -hex 32
#
# Даже с токеном открытый HTTP не шифрует его в локальной сети. Надёжнее
# привязаться к 127.0.0.1 и ходить через ssh-туннель; привязка к LAN с токеном —
# это удобство, а не защита от прослушивания.

# GATEHOUSE_PROVIDERS в этот файл не кладём: это не секрет, а путь, и его место в
# юните (`Environment=GATEHOUSE_PROVIDERS=/var/lib/gatehouse/providers`). Без него
# корень провайдеров берётся из умолчания сборки — тот же
# `/var/lib/gatehouse/providers`.

# Токен доступа. Обязателен при любом нелокальном GATEHOUSE_HOST.
#
# А 0.0.0.0 не используйте вовсе: на этом роутере на том же хосте живёт WAN-адрес
# (enp4s0), и привязка ко всем интерфейсам выставит редактор в интернет.
# Указывайте конкретный адрес — 10.95.2.1 или 127.0.0.1.
GATEHOUSE_TOKEN=replace-me-with-openssl-rand-hex-32

# --- Туннели ---------------------------------------------------------------
#
# Пути, а не секреты, поэтому они живут в юните (Environment=), а не здесь:
#
#   GATEHOUSE_AMNEZIA_DIR=/etc/gatehouse/tunnels   куда пишет «Применить» и
#                                                  откуда gatehouse-tunnel@<имя>
#                                                  читает
#   GATEHOUSE_SUDOERS=/etc/sudoers.d/gatehouse     что редактор ЧИТАЕТ, чтобы
#                                                  понять, какими туннелями вправе
#                                                  управлять
#
# Файл sudoers установите читаемым группе службы (`-o root -g denis`), иначе
# панель покажет все туннели без кнопок. Сами правила — по имени туннеля; готовые
# строки панель «Система» рисует на месте кнопок. См. `deploy/README.md`.
