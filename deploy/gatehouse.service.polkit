# GateHouse — вариант на polkit.
#
# Отличие от `deploy/gatehouse.service` ровно в трёх строках:
#
#   1. `GATEHOUSE_SUDO=none` — редактор вызывает `systemctl` напрямую и ни
#      разу не трогает sudo;
#   2. `NoNewPrivileges=yes` — можно, потому что setuid больше не нужен:
#      `systemctl` ходит к systemd по D-Bus, а не через setuid-хелпер;
#   3. правило polkit из `deploy/polkit/10-gatehouse.rules` разрешает ровно
#      `restart` ровно юнита `sing-box.service` от имени denis.
#
# Установка:
#
#   sudo cp deploy/gatehouse.service.polkit /etc/systemd/system/gatehouse.service
#   sudo install -d -m 0755 /etc/polkit-1/rules.d
#   sudo install -m 0644 deploy/polkit/10-gatehouse.rules /etc/polkit-1/rules.d/
#   # правило sudoers при этом варианте не нужно вовсе
#   sudo systemctl daemon-reload
#   sudo systemctl restart gatehouse
#
# Проверка, что правило живо (от имени denis):
#   systemctl restart sing-box
# Ответ «Interactive authentication required» означает, что правило не подхватилось.

[Unit]
Description=GateHouse — web editor of webui.json and config.json (polkit)
Documentation=file:///opt/gatehouse/deploy/README.md
After=network.target
Wants=network.target

[Service]
Type=simple
User=denis
Group=denis
WorkingDirectory=/opt/gatehouse
ExecStart=/usr/bin/node src/web/server.mjs

StateDirectory=gatehouse
StateDirectoryMode=0700
ConfigurationDirectory=gatehouse
ConfigurationDirectoryMode=0750

UMask=0027

Environment=GATEHOUSE_SETTINGS=/etc/gatehouse/webui.json
Environment=GATEHOUSE_STATE_DIR=/var/lib/gatehouse
Environment=GATEHOUSE_HOST=10.95.2.1
Environment=GATEHOUSE_PORT=9090
Environment=GATEHOUSE_CONFIG=/etc/sing-box/config.json
Environment=GATEHOUSE_SINGBOX=/usr/local/bin/sing-box
Environment=GATEHOUSE_SYSTEMCTL=/usr/bin/systemctl
Environment=GATEHOUSE_JOURNALCTL=/usr/bin/journalctl
Environment=GATEHOUSE_UNIT=sing-box
Environment=GATEHOUSE_AMNEZIA_DIR=/etc/amnezia/amneziawg
# С polkit правила sudoers не нужны; этот путь просто не существует, поэтому
# туннели показываются без кнопок, пока в polkit-правило не добавлены их юниты.
Environment=GATEHOUSE_SUDOERS=/etc/sudoers.d/gatehouse
# Никакого sudo: рестарт идёт через D-Bus и правило polkit.
Environment=GATEHOUSE_SUDO=none
EnvironmentFile=/etc/gatehouse/env

Restart=always
RestartSec=5

# Код переехал в /opt, поэтому обе защиты доступны.
#
# ProtectSystem=strict делает всю файловую систему доступной только для чтения
# внутри пространства имён этого юнита. Важное следствие: /opt/gatehouse
# принадлежит denis, но сервис всё равно не может переписать собственный код —
# а rsync владельца, живущий в обычном пространстве, пишет туда свободно.
# Каталоги из StateDirectory и ConfigurationDirectory systemd открывает на запись
# сам; /etc/sing-box и /etc/amnezia/amneziawg приходится разрешать явно.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/sing-box /etc/amnezia/amneziawg
# Здесь setuid не нужен — рестарт идёт по D-Bus, поэтому доступно и это.
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
